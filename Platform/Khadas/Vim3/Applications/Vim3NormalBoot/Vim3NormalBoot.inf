[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = Vim3NormalBoot
  FILE_GUID                      = 290fe396-cb76-4d70-81d4-bc06f9ef23ed
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = Vim3NormalBootEntryPoint

[Sources]
  Vim3NormalBoot.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  ArmSmcLib
  BaseMemoryLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib
