[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = Vim3MaskRomBoot
  FILE_GUID                      = 8f7c84d2-9b1e-4c6f-a1d3-6e07c00c15b4
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = Vim3MaskRomBootEntryPoint

[Sources]
  Vim3MaskRomBoot.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  ArmSmcLib
  BaseMemoryLib
  UefiApplicationEntryPoint
  UefiLib
