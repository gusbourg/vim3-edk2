[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = Vim3SdProbe
  FILE_GUID                      = 9de40458-a55d-46c4-b877-99ff838eb5c8
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = Vim3SdProbeEntryPoint

[Sources]
  Vim3SdProbe.c

[Packages]
  MdePkg/MdePkg.dec
  Silicon/Amlogic/MesonG12B/MesonG12B.dec

[LibraryClasses]
  ArmLib
  BaseLib
  DebugLib
  IoLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib

[Protocols]
  gEfiLoadedImageProtocolGuid
