[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = Vim3UsbBoot
  FILE_GUID                      = f5df20b0-3f8a-4abc-8dd1-bb97d134e729
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = Vim3UsbBootEntryPoint

[Sources]
  Vim3UsbBoot.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  ArmSmcLib
  BaseMemoryLib
  UefiApplicationEntryPoint
  UefiLib
