[Defines]
  INF_VERSION                    = 1.29
  BASE_NAME                      = Vim3SmbiosDxe
  FILE_GUID                      = 5b1ed630-354b-44d1-bfa1-0d770e080a72
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = Vim3SmbiosEntryPoint

[Sources]
  Vim3SmbiosDxe.c

[Packages]
  ArmPkg/ArmPkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  Platform/Khadas/Vim3/Vim3.dec
  Silicon/Amlogic/MesonG12B/MesonG12B.dec

[LibraryClasses]
  ArmLib
  BaseLib
  BaseMemoryLib
  DebugLib
  FdtLib
  HobLib
  MemoryAllocationLib
  PcdLib
  PrintLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  Vim3MesonSmLib

[Guids]
  gFdtHobGuid

[Protocols]
  gEfiSmbiosProtocolGuid

[Pcd]
  gEfiMdeModulePkgTokenSpaceGuid.PcdFirmwareReleaseDateString
  gEfiMdeModulePkgTokenSpaceGuid.PcdFirmwareVendor
  gEfiMdeModulePkgTokenSpaceGuid.PcdFirmwareVersionString

[Depex]
  gEfiSmbiosProtocolGuid
