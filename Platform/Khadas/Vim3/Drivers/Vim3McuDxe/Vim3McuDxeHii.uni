#langdef en-US "English"

#string STR_FORM_SET_TITLE  #language en-US "Khadas VIM3 Hardware"
#string STR_FORM_SET_HELP   #language en-US "Configure VIM3 board hardware managed by the onboard MCU."
#string STR_FORM_TITLE      #language en-US "Khadas VIM3 Hardware"
#string STR_FAN_PROMPT      #language en-US "Firmware fan level"
#string STR_FAN_HELP        #language en-US "Fan level applied by firmware during DXE. Linux takes over after boot."
#string STR_FAN_DISABLED    #language en-US "Disabled"
#string STR_FAN_LEVEL_1     #language en-US "Level 1 (default)"
#string STR_FAN_LEVEL_2     #language en-US "Level 2"
#string STR_FAN_LEVEL_3     #language en-US "Level 3"
#string STR_REBOOT_NOTE     #language en-US "Fan changes apply on the next reboot."
#string STR_HWDESC_PROMPT   #language en-US "OS hardware description"
#string STR_HWDESC_HELP     #language en-US "Device Tree: full hardware support (default). ACPI: standards-only description - the OS sees CPUs, USB, and display handoff but NO eMMC/SD, NO Ethernet, and NO serial console (USB storage, screen console only). Firmware setup itself is unaffected. Applies on the next reboot."
#string STR_HWDESC_DT       #language en-US "Device Tree (default)"
#string STR_HWDESC_ACPI     #language en-US "ACPI"
#string STR_MUX_TITLE       #language en-US "USB3 / M.2 PCIe selector"
#string STR_MUX_MODE_PROMPT #language en-US "USB3 / M.2 PCIe mode"
#string STR_MUX_MODE_HELP   #language en-US "Selects how the shared high-speed lanes are muxed. USB 3.0: the type-A USB3 port is active, M.2 is PCIe-disabled. M.2 PCIe: the M.2 slot runs PCIe (NVMe), and the type-A port drops to USB 2.0. Stored in the onboard MCU (the source of truth); shows the current mode. Applies on the next reboot."
#string STR_MUX_USB3_OPT    #language en-US "USB 3.0 (default)"
#string STR_MUX_M2_OPT      #language en-US "M.2 PCIe"
#string STR_MUX_REBOOT_NOTE #language en-US "Stored in the MCU. Reboot after changing modes."
#string STR_SPINOR_TITLE    #language en-US "SPI-NOR firmware install"
#string STR_SPINOR_WARN1    #language en-US "WARNING: this ERASES the SPI NOR boot region. If your board still"
#string STR_SPINOR_WARN2    #language en-US "carries oowow, it is overwritten. Reinstall it from Khadas if needed."
#string STR_SPINOR_PROMPT   #language en-US "Install firmware to SPI NOR"
#string STR_SPINOR_HELP     #language en-US "On next capsule update: the NEXT capsule writes the firmware to the SPI NOR as well as the eMMC rescue copy. Install now: the NEXT BOOT copies the firmware already in the eMMC boot partition straight into the NOR - no capsule, no file, nothing to download. Both then set the MCU to boot SPI-first. THIS ERASES OOWOW from the NOR; reinstall it from Khadas if you want it back. The setting clears itself after a verified write, so it will not reflash again. If the write fails it is kept so you can retry. Recovery: the eMMC copy still boots, and 'i2cset -f -y 0 0x18 0x20 1' plus a power cycle returns the board to eMMC-first."
#string STR_SPINOR_DISABLED #language en-US "Disabled (default)"
#string STR_SPINOR_ENABLED  #language en-US "Install on next capsule update"
#string STR_SPINOR_NOW      #language en-US "Install now (copy from eMMC on next boot)"
#string STR_NULL            #language en-US ""
#string STR_MCU_VERSION_PROMPT #language en-US "MCU firmware version"
#string STR_MCU_VERSION_HELP   #language en-US "Version reported by the onboard MCU (register 0x12; see the Khadas VIM3 MCU register map)."
#string STR_MCU_VERSION_VALUE  #language en-US "not read"
#string STR_DATETIME_TITLE  #language en-US "Date and time"
#string STR_DATE_PROMPT     #language en-US "System date"
#string STR_DATE_HELP       #language en-US "Real-time clock date (HYM8563). Changes are written to the RTC immediately."
#string STR_TIME_PROMPT     #language en-US "System time"
#string STR_TIME_HELP       #language en-US "Real-time clock time (HYM8563), 24-hour. Changes are written to the RTC immediately."
#string STR_HWMON_TITLE     #language en-US "Hardware monitor"
#string STR_SOC_TEMP_PROMPT #language en-US "SoC temperature"
#string STR_SOC_TEMP_HELP   #language en-US "On-die A311D temperature sensor, read when this page is opened."
#string STR_SOC_TEMP_VALUE  #language en-US "not read"

#string STR_WAKE_TITLE       #language en-US "Power-on / wake sources"
#string STR_WAKE_DISABLED    #language en-US "Disabled"
#string STR_WAKE_ENABLED     #language en-US "Enabled"
#string STR_WAKE_DCIN_PROMPT #language en-US "DC-in auto power-on"
#string STR_WAKE_DCIN_HELP   #language en-US "Power the board on automatically when DC power is applied (MCU register 0x25). Handy for an always-on appliance. Stored in the MCU; takes effect immediately."
#string STR_WAKE_KEY_PROMPT  #language en-US "Power key power-on"
#string STR_WAKE_KEY_HELP    #language en-US "Allow the front power button to power the board on (MCU register 0x26). If every wake source is disabled the MCU force-enables them. Stored in the MCU."
#string STR_WAKE_WOL_PROMPT  #language en-US "Wake-on-LAN"
#string STR_WAKE_WOL_HELP    #language en-US "Power on (or reset) the board from a Wake-on-LAN magic packet (MCU register 0x21). Requires WoL support to be armed by the OS. Stored in the MCU."
#string STR_WAKE_WOL_ON      #language en-US "Enabled (power on)"
#string STR_WAKE_WOL_RESET   #language en-US "Enabled (reset)"
#string STR_WAKE_RTC_PROMPT  #language en-US "RTC alarm power-on"
#string STR_WAKE_RTC_HELP    #language en-US "Power the board on from a scheduled RTC alarm (MCU register 0x22). Stored in the MCU; takes effect immediately."
#string STR_WAKE_IR_PROMPT   #language en-US "IR remote power-on"
#string STR_WAKE_IR_HELP     #language en-US "Power the board on from the configured infrared remote power key (MCU register 0x24). Set the key codes below. Stored in the MCU."
#string STR_WAKE_EXP_PROMPT  #language en-US "Expansion header (PA1) power-on"
#string STR_WAKE_EXP_HELP    #language en-US "Power on (or reset) the board from the 40-pin PA1 line (MCU register 0x23). Stored in the MCU."
#string STR_WAKE_EXP_RESET   #language en-US "Enabled (reset)"
#string STR_KEY_MODE_PROMPT  #language en-US "Power key press mode"
#string STR_KEY_MODE_HELP    #language en-US "How the front power button powers the board on (MCU register 0x27): a short press, or a long press held for one second. Stored in the MCU."
#string STR_KEY_SHORT        #language en-US "Short press"
#string STR_KEY_LONG         #language en-US "Long press (1 s)"
#string STR_LED_TITLE        #language en-US "Status LED"
#string STR_LED_ON_PROMPT    #language en-US "LED when powered on"
#string STR_LED_ON_HELP      #language en-US "Blue status-LED behaviour while the board is powered on (MCU register 0x28). Stored in the MCU."
#string STR_LED_OFF_PROMPT   #language en-US "LED when powered off"
#string STR_LED_OFF_HELP     #language en-US "Blue status-LED behaviour while the board is powered off (MCU register 0x29). Stored in the MCU."
#string STR_LED_OFF          #language en-US "Off"
#string STR_LED_ON           #language en-US "On"
#string STR_LED_BREATH       #language en-US "Breathe"
#string STR_LED_HEARTBEAT    #language en-US "Heartbeat"
#string STR_MCU_SLEEP_PROMPT #language en-US "MCU sleep after power-off"
#string STR_MCU_SLEEP_HELP   #language en-US "Let the MCU enter low-power sleep after the board powers off (MCU register 0x2e). Disable if a wake source stops working from the off state. Stored in the MCU."
#string STR_IR_TITLE         #language en-US "IR remote power key"
#string STR_IR_CODE1_PROMPT  #language en-US "IR power key code 1 (hex)"
#string STR_IR_CODE2_PROMPT  #language en-US "IR power key code 2 (hex)"
#string STR_IR_CODE_HELP     #language en-US "32-bit NEC-style IR code of the remote button that powers the board on (MCU registers 0x2f / 0x34), e.g. 0xF807FF00. Two codes can be programmed. Enable 'IR remote power-on' above. Stored in the MCU."
#string STR_DIAG_TITLE            #language en-US "Diagnostics"
#string STR_SHUTDOWN_STATUS_PROMPT #language en-US "Last power-off"
#string STR_SHUTDOWN_STATUS_HELP   #language en-US "Whether the last power-off was a clean shutdown or an abort/power-loss, reported by the MCU (register 0x86)."
#string STR_SHUTDOWN_STATUS_VALUE  #language en-US "not read"
