From: Gus Bourg <gus@bourg.net>
Date: Wed, 2 Sep 2026 17:30:00 -0700
Subject: soc amlogic meson canvas support ACPI PRP0001 probe

Written for the Khadas VIM3 EDK2 port.

Signed-off-by: Gus Bourg <gus@bourg.net>

diff --git a/drivers/soc/amlogic/meson-canvas.c b/drivers/soc/amlogic/meson-canvas.c
index 0711088..f404bd7 100644
--- a/drivers/soc/amlogic/meson-canvas.c
+++ b/drivers/soc/amlogic/meson-canvas.c
@@ -13,6 +13,7 @@
 #include <linux/soc/amlogic/meson-canvas.h>
 #include <linux/of_address.h>
 #include <linux/of_platform.h>
+#include <linux/property.h>
 #include <linux/io.h>
 
 #define NUM_CANVAS 256
@@ -55,6 +56,33 @@ struct meson_canvas *meson_canvas_get(struct device *dev)
 	struct platform_device *canvas_pdev;
 	struct meson_canvas *canvas;
 
+	/*
+	 * ACPI PRP0001 consumers (no of_node) reference the canvas provider
+	 * through a _DSD device reference of the same property name.
+	 */
+	if (!dev->of_node) {
+		struct fwnode_handle *fwnode;
+		struct device *canvas_dev;
+
+		fwnode = fwnode_find_reference(dev_fwnode(dev),
+					       "amlogic,canvas", 0);
+		if (IS_ERR(fwnode))
+			return ERR_PTR(-ENODEV);
+
+		canvas_dev = bus_find_device_by_fwnode(&platform_bus_type,
+						       fwnode);
+		fwnode_handle_put(fwnode);
+		if (!canvas_dev)
+			return ERR_PTR(-EPROBE_DEFER);
+
+		canvas = dev_get_drvdata(canvas_dev);
+		put_device(canvas_dev);
+		if (!canvas)
+			return ERR_PTR(-EINVAL);
+
+		return canvas;
+	}
+
 	canvas_node = of_parse_phandle(dev->of_node, "amlogic,canvas", 0);
 	if (!canvas_node)
 		return ERR_PTR(-ENODEV);
@@ -179,7 +207,7 @@ static int meson_canvas_probe(struct platform_device *pdev)
 	if (IS_ERR(canvas->reg_base))
 		return PTR_ERR(canvas->reg_base);
 
-	canvas->supports_endianness = of_device_get_match_data(dev);
+	canvas->supports_endianness = device_get_match_data(dev);
 
 	canvas->dev = dev;
 	spin_lock_init(&canvas->lock);
